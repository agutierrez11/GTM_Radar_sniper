# NERV MASTER ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values

# --- SUPABASE CONFIG ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# --- LLM SETTINGS ---
# Provider: "gemini" or "ollama"
LLM_PROVIDER=gemini

# Ollama Configuration (if provider is ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- AI & EMBEDDINGS (GEMINI) ---
# Round robin across 3 for rate limit management
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3

# --- SCRAPING (FIRECRAWL) ---
# Supports multiple keys for rotation
FIRECRAWL_API_KEY=your_firecrawl_key
FIRECRAWL_API_KEY_2=fc-xxx
FIRECRAWL_API_KEY_3=fc-xxx

# --- MARKET SIGNALS & URL LOOKUP (TAVILY) ---
TAVILY_API_KEY=your_tavily_key_1
TAVILY_API_KEY_2=your_tavily_key_2

# --- NOTIFICATIONS ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- ENGINE SETTINGS ---
MAX_WORKERS=8
BATCH_SIZE=40
CSV_SOURCE=./data/NERV_MASTER_VERIFIED.csv
LOG_PATH=./data/NERV_ENRICHED_OUTPUT.csv
