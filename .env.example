# NERV Environment Variables
# Copy this to .env.local and fill in your values

# Gemini API Keys (round robin across 3 for rate limit management)
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3_paid

# Scraping
FIRECRAWL_API_KEY=your_firecrawl_key

# Market Signals & URL Lookup (2 accounts for round robin)
TAVILY_API_KEY=your_tavily_key_1
TAVILY_API_KEY_2=your_tavily_key_2

# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Pipeline paths (adjust for your environment)
CSV_SOURCE=./data/NERV_MASTER_VERIFIED.csv
LOG_PATH=./data/NERV_ENRICHED_OUTPUT.csv
