# =============================================================================
# NERV — copia este archivo a .env en la RAÍZ del repo (no lo commitees)
# =============================================================================
# En Supabase: Project Settings → API → Project URL y anon / service_role keys.
# SUPABASE_URL debe ser URL absoluta con esquema. NUNCA uses //proyecto.supabase.co
# (sin https:) — rompe el backend y el cliente de Supabase.

# --- SUPABASE (una sola fuente para Docker: compose mapea a NEXT_PUBLIC_* en build) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Si en el dashboard ves claves con prefijo sb_publishable_ / sb_secret_, pégalas tal cual aquí.

# --- URLs PÚBLICAS (Next.js: bake en build del contenedor) ---
# Producción detrás de nginx + mismo dominio para FastAPI y Next:
NEXT_PUBLIC_SITE_URL=https://nerv.equalitech.xyz
NEXT_PUBLIC_API_URL=https://nerv.equalitech.xyz

# Local (pnpm dev): suele ser http://localhost:3000 y API en http://127.0.0.1:8000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- LLM ---
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- GEMINI (embeddings / LLM) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- SCRAPING / SEÑALES ---
FIRECRAWL_API_KEY=
FIRECRAWL_API_KEY_2=
FIRECRAWL_API_KEY_3=
TAVILY_API_KEY=
TAVILY_API_KEY_2=

# --- NOTIFICACIONES ---
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ENGINE (scripts Python / batch) ---
MAX_WORKERS=8
BATCH_SIZE=40
CSV_SOURCE=./data/NERV_MASTER_VERIFIED.csv
LOG_PATH=./data/NERV_ENRICHED_OUTPUT.csv
