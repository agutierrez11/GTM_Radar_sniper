# SNIPER FACTORY - ENVIRONMENT VARIABLES TEMPLATE
# Copia este archivo como '.env' en la carpeta /engine/ y rellena los valores.

# --- SUPABASE CONFIG ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# --- SCRAPING (FIRECRAWL) ---
# Puedes añadir múltiples llaves para rotación automática
FIRECRAWL_API_KEY=fc-xxx
FIRECRAWL_API_KEY_2=fc-xxx
FIRECRAWL_API_KEY_3=fc-xxx

# --- NOTIFICATIONS ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
TELEGRAM_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- MOTOR SETTINGS ---
# Puedes ajustar la potencia según los núcleos de tu VM
MAX_WORKERS=20
BATCH_SIZE=50
